---
pagination: { data: redirects, size: 1, alias: rd }
permalink: "{{ rd.from }}index.html"
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="{{ rd.lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% if rd.lang == 'de' %}Diese Seite ist umgezogen{% else %}This page has moved{% endif %}</title>
<link rel="canonical" href="https://victoriaswart.com{{ rd.to }}">
<meta http-equiv="refresh" content="0; url={{ rd.to }}">
<meta name="robots" content="noindex, follow">
<style>
  body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;
    background:#0B0B0C;color:#F1F0EC;font-family:system-ui,-apple-system,'Segoe UI',sans-serif;
    text-align:center;padding:24px;line-height:1.6}
  a{color:#B9A8B4}
</style>
</head>
<body>
<p>
  {% if rd.lang == 'de' %}Diese Seite ist umgezogen.{% else %}This page has moved.{% endif %}
  <br>
  <a href="{{ rd.to }}">{% if rd.lang == 'de' %}Weiter{% else %}Continue{% endif %}</a>
</p>
<script>location.replace({{ rd.to | json | safe }});</script>
</body>
</html>
