---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{%- set langs = ['en', 'de'] -%}
{#- Only languages whose copy actually exists belong in the sitemap.
    Italian and Spanish join this list when their copy lands. -#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for key, byLang in routes %}
{%- for lang in langs %}
  <url>
    <loc>https://victoriaswart.com{{ byLang[lang] }}</loc>
{%- for alt in langs %}
    <xhtml:link rel="alternate" hreflang="{{ alt }}" href="https://victoriaswart.com{{ byLang[alt] }}"/>
{%- endfor %}
    <xhtml:link rel="alternate" hreflang="x-default" href="https://victoriaswart.com{{ byLang['en'] }}"/>
    <changefreq>{% if key == 'journal' %}weekly{% elif key == 'privacy' or key == 'legal' %}yearly{% else %}monthly{% endif %}</changefreq>
    <priority>{% if key == 'home' %}1.0{% elif key == 'webdesign' or key == 'strategy' or key == 'languages' %}0.9{% elif key == 'privacy' or key == 'legal' %}0.3{% else %}0.7{% endif %}</priority>
  </url>
{%- endfor %}
{%- endfor %}
</urlset>
