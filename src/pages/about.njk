---
pagination: { data: site.locales, size: 1, alias: lang }
permalink: "{{ routes.about[lang] }}index.html"
layout: layouts/base.njk
routeKey: about
copyKey: about
ogImage: victoria-swart-networking.jpg
---
{% set c = copy.about %}
<section>
  <h1>{{ c.h1 }}</h1>
  <p class="lead">{{ c.lead }}</p>
</section>
<figure class="figure-inset figure-inset--narrow reveal">
  <img src="/assets/about-portrait.jpg" alt="{{ c.portraitAlt }}"
       width="1084" height="724" loading="lazy" decoding="async">
</figure>
<section><h2>{{ c.shapedTitle }}</h2><p>{{ c.shaped }}</p><p>{{ c.stage }}</p></section>
<figure class="band-photo reveal">
  <img src="/assets/about-harbour-1600.jpg"
       srcset="/assets/about-harbour-900.jpg 900w, /assets/about-harbour-1600.jpg 1600w"
       sizes="100vw" width="1600" height="1066"
       alt="{{ c.harbourAlt }}" loading="lazy" decoding="async">
</figure>
<section><h2>{{ c.expTitle }}</h2><ul class="tick-list">{% for e in c.exp %}<li>{{ e }}</li>{% endfor %}</ul></section>
<section>
  <div class="media-split media-split--centre">
    <div>
      <h2>{{ c.goodTitle }}</h2>
      <p class="lead">{{ c.good }}</p>
    </div>
    <img src="/assets/about-conversation.jpg" alt="{{ c.conversationAlt }}"
         width="768" height="1024" loading="lazy" decoding="async">
  </div>
</section>
<section class="closing-band">
  <p class="closing-text">{{ copy.home.closing }}</p>
  <a class="btn btn-light" href="{{ 'contact' | route(lang) }}">{{ t.cta.write }}</a>
</section>
