---
pagination: { data: site.locales, size: 1, alias: lang }
permalink: "{{ routes.about[lang] }}index.html"
layout: layouts/base.njk
routeKey: about
copyKey: about
ogImage: victoria-swart-networking.jpg
---
{% set c = copy.about %}
<section>
  <h1>{{ c.h1 }}</h1>
  <p class="lead">{{ c.lead }}</p>
</section>
<section><h2>{{ c.shapedTitle }}</h2><p>{{ c.shaped }}</p><p>{{ c.stage }}</p></section>
<section><h2>{{ c.expTitle }}</h2><ul class="tick-list">{% for e in c.exp %}<li>{{ e }}</li>{% endfor %}</ul></section>
{#- The one photograph left on the page, so it gets half the screen.
    sizes="50vw" above the stacking breakpoint: the source is 768px wide and
    the browser should know the slot is about that, not the full width. -#}
<section class="split-feature reveal">
  <div class="split-feature__body">
    <h2>{{ c.goodTitle }}</h2>
    <p class="lead">{{ c.good }}</p>
  </div>
  <div class="split-feature__media">
    <img src="/assets/about-conversation.jpg" alt="{{ c.conversationAlt }}"
         width="768" height="1024"
         sizes="(min-width:861px) 50vw, 100vw"
         loading="lazy" decoding="async">
  </div>
</section>
<section class="closing-band">
  <p class="closing-text">{{ copy.home.closing }}</p>
  <a class="btn btn-light" href="{{ 'contact' | route(lang) }}">{{ t.cta.write }}</a>
</section>
