---
pagination: { data: site.locales, size: 1, alias: lang }
permalink: "{{ routes.webdesign[lang] }}index.html"
layout: layouts/base.njk
routeKey: webdesign
copyKey: webdesign
ogImage: video/hero/hero-poster-desktop.jpg
---
{% set c = copy.webdesign %}
<section>
  <h1>{{ c.h1 }}</h1>
  <p class="lead">{{ c.intro }}</p>
</section>

<section>
  <h2>{{ c.recentTitle }}</h2>
  <div class="card-grid">
  {%- for key in ["seabreeze","eqm","graziano","homeserv","ladolcevita","thissite"] %}
  {%- set cs = cases[key] %}{% set ct = cs[lang] %}
  {%- set named = (not cs.flag) or flags[cs.flag] %}
    <a class="case-card" href="{{ cs.route | route(lang) }}">
      <img src="/assets/{{ cs.image }}" alt="{{ ct.sector }}" width="960" height="600" loading="lazy" decoding="async">
      <h3>{{ ct.name if named else ct.nameFallback }}</h3>
      <p>{{ ct.sector }}, {{ ct.location }} &middot; {{ cs.stack[lang] }}</p>
    </a>
  {%- endfor %}
  </div>
</section>

<section class="band-light">
  <h2>{{ c.howTitle }}</h2>
  <ol class="step-list">
  {%- for s in c.how %}
    <li><span class="step-n">{{ s.n }}</span><span><span class="step-t">{{ s.t }}</span><span class="step-d">{{ s.d }}</span></span></li>
  {%- endfor %}
  </ol>
</section>

<section>
  <h2>{{ c.includedTitle }}</h2>
  <ul class="tick-list">{% for i in c.included %}<li>{{ i }}</li>{% endfor %}</ul>
  <p class="tools-line">{{ c.toolsTitle }}</p>
  <ul class="tag-row">{% for i in c.tools %}<li>{{ i }}</li>{% endfor %}</ul>
</section>

{#- Project types as blocks. Each one opens in place rather than navigating
    away, because someone comparing shapes wants to compare them side by side.
    <details> does the opening, so it works with no JavaScript at all and the
    content is in the HTML for search engines either way. Every block ends at
    a real site, not a mock-up. -#}
<section>
  <h2>{{ t.ptype.typesTitle }}</h2>
  <p class="lead">{{ t.ptype.typesIntro }}</p>
  <div class="ptype-grid">
    {%- for key, p in projectTypes %}
    {%- set pc = p[lang] %}
    <details class="ptype">
      <summary>
        <span class="ptype-shape">{{ p.shape }}</span>
        <span class="ptype-name">{{ pc.name }}</span>
        <span class="ptype-sum">{{ pc.sum }}</span>
        <span class="ptype-open">{{ t.ptype.open }}</span>
      </summary>
      <div class="ptype-body">
        <h3>{{ t.ptype.includes }}</h3>
        <ul class="tick-list">{% for i in pc.has %}<li>{{ i }}</li>{% endfor %}</ul>
        <h3>{{ t.ptype.suits }}</h3>
        <p>{{ pc['for'] }}</p>
        <a class="link-more" href="{{ cases[p.case].route | route(lang) }}">{{ t.ptype.example }} &rarr;</a>
      </div>
    </details>
    {%- endfor %}
  </div>
</section>

<section class="band-light">
  <h2>{{ c.pricingTitle }}</h2>
  <div class="price-table">
  {%- for p in c.pricing %}
    <div class="price-row"><div><h3>{{ p.t }}</h3><p>{{ p.d }}</p></div><div class="price-val">{{ p.p }}</div></div>
  {%- endfor %}
  </div>
  <p class="price-note">{{ c.pricingNote }}</p>
</section>

<section class="closing-band">
  <p class="closing-text">{{ t.case.cta }}</p>
  <a class="btn btn-light" href="{{ 'contact' | route(lang) }}?topic=website">{{ c.cta }}</a>
</section>
