{%- set L = L or (cp.lang if cp) or (lp.lang if lp) or lang %}
{%- set routeKey = routeKey or (cp.key if cp) or (lp.key if lp) %}
{%- set t = t or i18n[L] %}
{%- set copy = copy or allCopy[L] %}
<!DOCTYPE html>
<html lang="{{ t.htmlLang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta name="author" content="{{ site.name }}">
<link rel="canonical" href="{{ (routeKey | route(L)) | abs }}">
{%- for a in routeKey | alternates %}
<link rel="alternate" hreflang="{{ a.lang }}" href="{{ a.url | abs }}">
{%- endfor %}
<link rel="alternate" hreflang="x-default" href="{{ (routeKey | route('en')) | abs }}">

{#- The hero poster is the LCP element on pages that carry one. Preloading it
    with the same media queries the <picture> uses means the browser fetches
    exactly the crop it will paint, and starts before the CSS has parsed. -#}
{%- if heroPoster %}
{#- One of these three matches, on the same aspect-ratio boundaries the
    <picture> and cutFor() use. Keep all three in step. -#}
<link rel="preload" as="image" media="(max-aspect-ratio:68/100)"
      href="/assets/video/hero/hero-poster-mobile.webp" type="image/webp" fetchpriority="high">
<link rel="preload" as="image" media="(min-aspect-ratio:68/100) and (max-aspect-ratio:120/100)"
      href="/assets/video/hero/hero-poster-panel.webp" type="image/webp" fetchpriority="high">
<link rel="preload" as="image" media="(min-aspect-ratio:120/100)"
      href="/assets/video/hero/hero-poster-desktop.webp" type="image/webp" fetchpriority="high">
{%- endif %}

<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16.png">
<link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#0B0B0C">

{#- GitHub Pages cannot send response headers, so the policy goes in the
    document. 'unsafe-inline' is still needed for the inline theme script and
    the inline style attributes; it blocks any externally injected script.
    frame-ancestors and X-Content-Type-Options cannot be set this way. -#}
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io; upgrade-insecure-requests">
<meta name="referrer" content="strict-origin-when-cross-origin">

<meta name="robots" content="{{ robots or 'index, follow, max-snippet:-1, max-image-preview:large' }}">
<meta name="geo.region" content="IT-RM">
<meta name="geo.placename" content="Rome, Italy">

<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:url" content="{{ (routeKey | route(L)) | abs }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:image" content="{{ ('/assets/' + (ogImage or 'victoriahero.jpg')) | abs }}">
<meta property="og:image:alt" content="{{ ogAlt or site.name }}">
<meta property="og:locale" content="{{ t.ogLocale }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ ('/assets/' + (ogImage or 'victoriahero.jpg')) | abs }}">

{% include "partials/schema.njk" %}
<script>
  if ('IntersectionObserver' in window &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('js-reveal');
  }
</script>
<link rel="stylesheet" href="/assets/css/site.css">
</head>
<body data-lang="{{ L }}" data-route="{{ routeKey }}">
<a class="skip" href="#main">{{ t.skip }}</a>
{% include "partials/header.njk" %}
<main id="main">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
<script>window.__routes={{ routes | dump | safe }};</script>
<script src="/assets/js/site.js" defer></script>
</body>
</html>
