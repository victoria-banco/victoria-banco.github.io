<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Victoria Clara Swart",
  "alternateName": "Victoria Swart",
  "jobTitle": {{ schemaJobTitle | dump | safe }},
  "url": {{ site.url | dump | safe }},
  "image": {{ ('/assets/victoriahero.jpg' | abs) | dump | safe }},
  "email": {{ site.email | dump | safe }},
  "address": { "@type": "PostalAddress", "addressLocality": "Rome", "addressCountry": "IT" },
  "knowsLanguage": ["de", "en", "it", "es", "da"],
  "alumniOf": { "@type": "CollegeOrUniversity", "name": "University of Southern Denmark" },
  "sameAs": [
    {{ site.social.linkedin | dump | safe }},
    {{ site.social.instagram | dump | safe }},
    {{ site.social.substack | dump | safe }}
  ]
}
</script>
{%- if routeKey != 'home' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": {{ t.nav.home | dump | safe }}, "item": {{ ('home' | route(L) | abs) | dump | safe }} },
    { "@type": "ListItem", "position": 2, "name": {{ title | dump | safe }}, "item": {{ (routeKey | route(L) | abs) | dump | safe }} }
  ]
}
</script>
{%- endif %}
{%- if extraSchema %}
<script type="application/ld+json">
{{ extraSchema | safe }}
</script>
{%- endif %}

{%- if routeKey == 'home' and copy.home and copy.home.doors %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Victoria Clara Swart",
  "url": {{ ('home' | route(L) | abs) | dump | safe }},
  "image": {{ ('/assets/victoriahero.jpg' | abs) | dump | safe }},
  "email": {{ site.email | dump | safe }},
  "description": {{ copy.home.description | dump | safe }},
  "priceRange": "\u20ac\u20ac",
  "address": { "@type": "PostalAddress", "addressLocality": "Rome", "addressCountry": "IT" },
  "areaServed": { "@type": "Place", "name": "Europe" },
  "availableLanguage": ["de", "en", "it", "es", "da"],
  "founder": { "@type": "Person", "name": "Victoria Clara Swart" },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": {{ copy.home.doorsTitle | dump | safe }},
    "itemListElement": [
      {%- for d in copy.home.doors %}
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": {{ d.title | dump | safe }},
          "description": {{ d.text | dump | safe }},
          "url": {{ (d.route | route(L) | abs) | dump | safe }}
        }
      }{% if not loop.last %},{% endif %}
      {%- endfor %}
    ]
  }
}
</script>
{%- endif %}
{%- if routeKey == 'strategy' and copy.strategy and copy.strategy.faq %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for f in copy.strategy.faq %}
    {
      "@type": "Question",
      "name": {{ f.q | dump | safe }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ f.a | dump | safe }} }
    }{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>
{%- endif %}
