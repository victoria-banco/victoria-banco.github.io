<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Victoria Clara Swart",
  "alternateName": "Victoria Swart",
  "jobTitle": {{ schemaJobTitle | dump | safe }},
  "url": {{ site.url | dump | safe }},
  "image": {{ ('/assets/victoriahero.jpg' | abs) | dump | safe }},
  "email": {{ site.email | dump | safe }},
  "address": { "@type": "PostalAddress", "addressLocality": "Rome", "addressCountry": "IT" },
  "knowsLanguage": ["de", "en", "it", "es", "da"],
  "alumniOf": { "@type": "CollegeOrUniversity", "name": "University of Southern Denmark" },
  "sameAs": [
    {{ site.social.linkedin | dump | safe }},
    {{ site.social.instagram | dump | safe }},
    {{ site.social.substack | dump | safe }}
  ]
}
</script>
{%- if routeKey != 'home' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": {{ t.nav.home | dump | safe }}, "item": {{ ('home' | route(lang) | abs) | dump | safe }} },
    { "@type": "ListItem", "position": 2, "name": {{ title | dump | safe }}, "item": {{ (routeKey | route(lang) | abs) | dump | safe }} }
  ]
}
</script>
{%- endif %}
{%- if extraSchema %}
<script type="application/ld+json">
{{ extraSchema | safe }}
</script>
{%- endif %}
