<header class="site-header">
  <nav class="nav" aria-label="{{ t.navAria }}">
    <a class="nav-logo" href="{{ 'home' | route(L) }}">{{ site.name }}</a>

    <ul class="nav-links">
      {%- for key, label in [["webdesign", t.nav.web], ["strategy", t.nav.strategy], ["languages", t.nav.languages], ["work", t.nav.work], ["about", t.nav.about], ["contact", t.nav.contact]] %}
      <li><a href="{{ key | route(L) }}"{% if key == routeKey %} aria-current="page"{% endif %}>{{ label }}</a></li>
      {%- endfor %}
    </ul>

    <div class="lang-switch">
      <button type="button" class="lang-current" aria-haspopup="listbox" aria-expanded="false" aria-label="{{ t.langLabel }}" data-short="{{ L | upper }}">
        <span>{{ t.native }}</span>
        <svg width="9" height="6" viewBox="0 0 9 6" aria-hidden="true"><path d="M1 1l3.5 3.5L8 1" fill="none" stroke="currentColor" stroke-width="1"/></svg>
      </button>
      <div class="lang-menu" role="listbox">
        {%- for a in routeKey | alternates %}
        <a role="option" href="{{ a.url }}" hreflang="{{ a.lang }}" lang="{{ a.lang }}"{% if a.lang == L %} aria-current="true"{% endif %}>{{ i18n[a.lang].native }}</a>
        {%- endfor %}
      </div>
    </div>

    <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="{{ t.menu }}">
      <span></span><span></span><span></span>
    </button>
  </nav>
</header>

<div class="mobile-nav" id="mobile-nav" hidden>
  <button type="button" class="mobile-close" aria-label="{{ t.close }}">
    <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M3 3l16 16M19 3L3 19" stroke="currentColor" stroke-width="1.4" fill="none"/></svg>
  </button>
  <a class="mobile-home" href="{{ 'home' | route(L) }}">{{ t.nav.home }}</a>
  {%- for key, label in [["webdesign", t.nav.web], ["strategy", t.nav.strategy], ["languages", t.nav.languages], ["work", t.nav.work], ["about", t.nav.about], ["contact", t.nav.contact]] %}
  <a href="{{ key | route(L) }}">{{ label }}</a>
  {%- endfor %}
  <p class="mobile-foot">{{ t.location }}</p>
</div>
